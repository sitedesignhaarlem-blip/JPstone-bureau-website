---
// "How it works": the three steps. Used on the home page and on the how-it-works page.
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  heading?: 'h1' | 'h2';
}
const { lang, heading = 'h2' } = Astro.props;
const t = useTranslations(lang);
const Heading = heading;
// Step titles sit one level below the section heading.
const Item = heading === 'h1' ? 'h2' : 'h3';
---
<section class="section steps-section">
  <div class="wrap">
    <Heading class="steps-title">{t.steps.title}</Heading>
    <ol class="steps" role="list">
      <li><span class="numeral">1</span><Item class="step-title">{t.steps.s1Title}</Item><p class="muted">{t.steps.s1Text}</p></li>
      <li><span class="numeral">2</span><Item class="step-title">{t.steps.s2Title}</Item><p class="muted">{t.steps.s2Text}</p></li>
      <li><span class="numeral">3</span><Item class="step-title">{t.steps.s3Title}</Item><p class="muted">{t.steps.s3Text}</p></li>
    </ol>
  </div>
</section>

<style>
  .steps-title { margin-bottom: var(--space-7); }
  .steps { display: grid; gap: var(--space-6); padding: 0; list-style: none; }
  .steps li { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .steps .numeral { margin-bottom: var(--space-3); }
  h1.steps-title { font-size: var(--step-h2); line-height: 1.07; }
  @media (min-width: 48rem) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  }
</style>
