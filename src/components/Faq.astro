---
// Frequently asked questions as native <details>, so they work without JavaScript and with the keyboard.
// Without items it shows the general FAQ; landing pages pass their own questions.
import Text from './Text.astro';
import { useTranslations, type Locale } from '../i18n';
import type { FaqItem } from '../data/schema';

interface Props {
  lang: Locale;
  items?: FaqItem[];
  title?: string;
  /** Optional link under the list, e.g. to the full FAQ page. */
  more?: { href: string; label: string };
}
const t = useTranslations(Astro.props.lang);
const { items = t.faq.items, title = t.faq.title, more } = Astro.props;
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="wrap faq-inner">
    <h2 id="faq-title">{title}</h2>
    <div class="faq-list">
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p class="muted"><Text text={item.a} /></p>
        </details>
      ))}
    </div>
    {more && <p><a class="link-more" href={more.href}>{more.label}</a></p>}
  </div>
</section>

<style>
  .faq-inner { display: grid; gap: var(--space-6); }
  .faq-list { border-bottom: 1px solid var(--line); }
  details { border-top: 1px solid var(--line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding-block: var(--space-4); font-size: var(--step-lead); font-weight: 600; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font-weight: 400; font-size: 1.5rem; line-height: 1; color: var(--fg-muted); transition: transform var(--dur) var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding-bottom: var(--space-5); max-width: 60ch; }
  @media (min-width: 48rem) {
    .faq-inner { grid-template-columns: 1fr 2fr; gap: var(--space-8); align-items: start; }
  }
</style>
