---
// A softly bobbing arrow at the bottom of a section, so it's clear the page goes on.
// Clicking it scrolls to the next section. Place it inside a section with position: relative.
import { themeUI } from '../i18n/theme';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const label = themeUI[Astro.props.lang].more;
---
<button class="scroll-cue" type="button" data-scroll-cue aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-scroll-cue]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = btn.closest('section')?.nextElementSibling as HTMLElement | null;
      next?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );
</script>

<style>
  /* Quiet, like the rest of the site: a thin chevron in the muted text colour, no circle. */
  .scroll-cue {
    position: absolute; left: 50%; bottom: var(--space-5); z-index: 2;
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0;
    border: 0; border-radius: 50%; background: none;
    color: var(--on-dark-muted); cursor: pointer;
    transform: translateX(-50%);
    animation: bob 2.4s var(--ease) infinite;
    transition: color var(--dur) var(--ease);
  }
  .scroll-cue:hover { color: var(--on-dark); }
  .scroll-cue svg { width: 28px; height: 28px; }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { animation: none; }
  }
</style>
