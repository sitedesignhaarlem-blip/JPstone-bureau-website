---
// Prices on the home page: Standard and Premium, then the price calculator, the same as on the
// pricing page. Numbers come from src/data/pricing.config.ts.
import PriceCalculator from './PriceCalculator.astro';
import TierCards from './TierCards.astro';
import { hasPage, pagePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.packages;
---
<section class="section section--alt packages" aria-labelledby="packages-title">
  <div class="wrap">
    <div class="packages-head">
      <h2 id="packages-title">{p.title}</h2>
      <p class="lead muted">{p.lead}</p>
    </div>
    <div class="packages-body">
      <TierCards lang={lang} />
      <PriceCalculator lang={lang} />
    </div>
    {hasPage(lang, 'pricing') && <p class="packages-note"><a class="link-more" href={pagePath(lang, 'pricing')}>{t.landing.fullPricing}</a></p>}
  </div>
</section>

<style>
  .packages-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-6); }
  .packages-body { max-width: 52rem; }
  .packages-note { margin-top: var(--space-2); }
</style>
