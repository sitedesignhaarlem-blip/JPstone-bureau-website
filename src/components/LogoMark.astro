---
// The Still to Film mark: a frame that is a still photo on the left and film (with a play
// button) on the right. The play button is cut out, so the mark works on any background.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---
<svg class="logo-mark" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" focusable="false">
  <rect x="3.5" y="7.5" width="33" height="25" rx="5" fill="none" stroke="currentColor" stroke-width="3" />
  <path fill="currentColor" fill-rule="evenodd" d="M20 6h12a6 6 0 0 1 6 6v16a6 6 0 0 1-6 6H20z M25 14.5v11l8-5.5z" />
</svg>
