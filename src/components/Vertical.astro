---
// Both deliverables side by side: the 16:9 film on a laptop and the 9:16 cut on a phone.
// The tabs swap both screens to one of the clips from the before/after slider.
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const t = useTranslations(Astro.props.lang);
const v = t.vertical;
const clips = ['southern-cross-varen-zij', 'southern-cross-drone-anker', 'southern-cross-kombuis'].map((file) => ({
  file,
  label: t.compare.pairs[file as keyof typeof t.compare.pairs],
  alt: t.shots[file as keyof typeof t.shots].alt,
  thumb: `/media/thumb-${file.replace('southern-cross-', '')}.jpg`,
}));
const first = clips[0];
---
<section class="section section--alt devices" aria-labelledby="devices-title" data-devices>
  <div class="wrap">
    <div class="devices-text">
      <p class="eyebrow">{v.eyebrow}</p>
      <h2 id="devices-title">{v.title}</h2>
      <p class="lead muted">{v.lead}</p>
    </div>

    <div class="stage">
      <figure class="laptop">
        <div class="laptop-screen">
          <video muted playsinline loop preload="none" poster={`/media/${first.file}.jpg`} aria-label={first.alt} width="960" height="712" data-device="">
            <source src={`/media/${first.file}.mp4`} type="video/mp4" />
            <source src={`/media/${first.file}.webm`} type="video/webm" />
          </video>
        </div>
        <div class="laptop-base" aria-hidden="true"></div>
        <figcaption>16:9</figcaption>
      </figure>
      <figure class="phone">
        <div class="phone-screen">
          <video muted playsinline loop preload="none" poster={`/media/${first.file}-916.jpg`} aria-label={first.alt} width="540" height="960" data-device="-916">
            <source src={`/media/${first.file}-916.mp4`} type="video/mp4" />
            <source src={`/media/${first.file}-916.webm`} type="video/webm" />
          </video>
        </div>
        <figcaption>9:16</figcaption>
      </figure>
    </div>

    <div class="device-tabs" role="group" aria-label={t.compare.choose}>
      {clips.map((clip, i) => (
        <button type="button" class="device-tab" data-clip={clip.file} data-alt={clip.alt} aria-pressed={i === 0 ? 'true' : 'false'}>
          <img src={clip.thumb} alt="" width="96" height="71" loading="lazy" decoding="async" />
          <span>{clip.label}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  // Plays both screens while in view; a tab swaps both to the same clip.
  const root = document.querySelector<HTMLElement>('[data-devices]');
  if (root) {
    const videos = [...root.querySelectorAll<HTMLVideoElement>('video[data-device]')];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;

    const play = () => {
      if (still || !inView) return;
      for (const v of videos) {
        v.preload = 'auto';
        v.play().catch(() => {});
      }
    };

    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      if (inView) play();
      else videos.forEach((v) => v.pause());
    }, { threshold: 0.3 }).observe(root.querySelector('.stage')!);

    root.querySelectorAll<HTMLButtonElement>('[data-clip]').forEach((tab) => {
      tab.addEventListener('click', () => {
        if (tab.getAttribute('aria-pressed') === 'true') return;
        root.querySelectorAll('[data-clip]').forEach((b) => b.setAttribute('aria-pressed', String(b === tab)));
        const file = tab.dataset.clip!;
        for (const v of videos) {
          const name = `/media/${file}${v.dataset.device}`;
          v.poster = `${name}.jpg`;
          v.setAttribute('aria-label', tab.dataset.alt!);
          const [mp4, webm] = v.querySelectorAll('source');
          mp4.src = `${name}.mp4`;
          webm.src = `${name}.webm`;
          v.load();
        }
        play();
      });
    });
  }
</script>

<style>
  .devices-text { display: grid; gap: var(--space-3); max-width: 34rem; margin-bottom: var(--space-7); }

  /* Laptop takes most of the width; the phone stands in front of its right edge. */
  .stage { display: flex; align-items: flex-end; padding-bottom: var(--space-2); }
  figure { margin: 0; }
  figcaption { margin-top: var(--space-2); font-size: var(--step-small); font-weight: 600; color: var(--fg-muted); text-align: center; font-variant-numeric: tabular-nums; }

  .laptop { flex: 1; min-width: 0; }
  .laptop-screen {
    padding: 2.2% 2.2% 3.2%; border-radius: 1rem 1rem 0 0;
    background: #1d1d1f; box-shadow: inset 0 0 0 1px #3a3a3c;
  }
  .laptop-base {
    position: relative; height: clamp(0.6rem, 1.6vw, 1rem); width: 114%; margin-left: -7%;
    background: linear-gradient(#e3e3e8, #b9b9bf); border-radius: 0 0 1rem 1rem;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.14);
  }
  .laptop-base::before {
    content: ''; position: absolute; top: 0; left: 50%; width: 16%; height: 40%;
    transform: translateX(-50%); background: #a9a9af; border-radius: 0 0 0.5rem 0.5rem;
  }

  .phone { position: relative; flex: 0 0 34%; margin-left: -12%; }
  .phone-screen {
    aspect-ratio: 9 / 19.5; padding: 5%; border-radius: clamp(1.1rem, 3.5vw, 2.4rem);
    background: #1d1d1f; box-shadow: 0 20px 50px rgb(0 0 0 / 0.22), inset 0 0 0 1px #3a3a3c;
  }

  .stage video { width: 100%; height: 100%; object-fit: cover; background: #000; display: block; }
  .laptop-screen video { aspect-ratio: 16 / 9; height: auto; border-radius: 0.25rem; }
  .phone-screen video { border-radius: clamp(0.8rem, 2.8vw, 1.9rem); }

  .device-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); margin-top: var(--space-6); }
  .device-tab {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 2.75rem;
    padding: 0.3rem 1rem 0.3rem 0.3rem; border: 1px solid var(--line); border-radius: var(--radius-pill);
    background: var(--bg); color: var(--fg); font: inherit; font-weight: 600; cursor: pointer;
  }
  .device-tab img { width: 2.4rem; height: 2.4rem; object-fit: cover; border-radius: var(--radius-pill); }
  .device-tab:hover { border-color: var(--fg); }
  .device-tab[aria-pressed='true'] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }

  @media (min-width: 48rem) {
    .stage { max-width: 60rem; margin-inline: auto; }
    .phone { flex-basis: 26%; margin-left: -10%; }
  }
</style>
