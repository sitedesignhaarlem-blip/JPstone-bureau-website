---
// Contact block with form, WhatsApp, phone and email. Used on the home page and on the contact page.
import { site } from '../data/site';
import { pagePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  heading?: 'h1' | 'h2';
}
const { lang, heading = 'h2' } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
const Heading = heading;
const hasBooking = site.booking.startsWith('http');
const Sub = heading === 'h1' ? 'h2' : 'h3';
const formAction = site.formEndpoint || `mailto:${site.email}?subject=${encodeURIComponent(c.mailSubject)}`;
---
<section class="section section--alt contact-section">
  <div class="wrap contact">
    <div class="contact-intro">
      <Heading class="contact-title">{c.title}</Heading>
      <p class="lead muted">{c.lead}</p>
      <ul class="contact-direct" role="list">
        <li><span class="muted">{c.whatsapp}</span><a href={site.whatsapp} rel="noopener">{site.phoneDisplay}</a></li>
        <li><span class="muted">{c.call}</span><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></li>
        <li><span class="muted">{c.email}</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <div class="booking">
        <Sub class="booking-title">{t.booking.title}</Sub>
        <p class="muted">{t.booking.text}</p>
        {hasBooking
          ? <a class="button button--secondary" href={site.booking} rel="noopener">{t.booking.cta}</a>
          : <p><span class="todo">{t.booking.cta}: {site.booking}</span></p>}
      </div>
    </div>

    <form
      class="contact-form"
      action={formAction}
      method="post"
      enctype={site.formEndpoint ? undefined : 'text/plain'}
      data-contact
      data-endpoint={site.formEndpoint}
      data-email={site.email}
      data-subject={c.mailSubject}
      data-sending={c.sending}
      data-sent={c.sent}
      data-failed={c.failed.replace('{email}', site.email)}
    >
      <input type="hidden" name="language" value={lang} />
      <div class="field">
        <label for="cf-name">{c.name}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-company">{c.company} <span class="optional">{c.optional}</span></label>
        <input id="cf-company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="cf-url">{c.url}</label>
        <input id="cf-url" name="listing" type="url" inputmode="url" placeholder="https://" required />
      </div>
      <div class="field">
        <label for="cf-msg">{c.message} <span class="optional">{c.optional}</span></label>
        <textarea id="cf-msg" name="message" rows="4"></textarea>
      </div>
      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="button" type="submit">{c.submit}</button>
      <p class="form-note muted">{c.noteBefore} <a href={pagePath(lang, 'privacy')}>{c.noteLink}</a>{c.noteAfter}</p>
      <p class="form-status muted" data-status aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Contact form: post to the form service when one is set, otherwise open the mail app.
  // Messages come from data attributes, so they are in the page's language.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    const d = form.dataset;
    if (!d.endpoint) {
      const body = [...data.entries()].filter(([k]) => k !== '_gotcha').map(([k, v]) => `${k}: ${v}`).join('\n');
      window.location.href = `mailto:${d.email}?subject=${encodeURIComponent(d.subject ?? '')}&body=${encodeURIComponent(body)}`;
      return;
    }
    if (status) status.textContent = d.sending ?? '';
    try {
      const res = await fetch(d.endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      if (status) status.textContent = d.sent ?? '';
    } catch {
      if (status) status.textContent = d.failed ?? '';
    }
  });
</script>

<style>
  .booking { display: grid; gap: var(--space-2); justify-items: start; margin-top: var(--space-6); padding: var(--space-5); border-radius: var(--radius); background: var(--bg); }
  .booking :global(.booking-title) { font-size: var(--step-h3); line-height: 1.14; }
  .booking .button { margin-top: var(--space-2); }
  .contact { display: grid; gap: var(--space-8); }
  .contact-intro { display: grid; gap: var(--space-4); align-content: start; }
  .contact-direct { display: grid; gap: var(--space-3); padding: 0; margin: var(--space-4) 0 0; list-style: none; }
  .contact-direct li { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .contact-form { display: grid; gap: var(--space-5); padding: var(--space-5); background: var(--bg); border-radius: var(--radius); }
  .field { display: grid; gap: var(--space-2); }
  .field label { font-size: var(--step-small); font-weight: 600; }
  .field input, .field textarea {
    width: 100%; padding: 0.75rem 0.875rem; font-size: var(--step-body);
    border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--fg);
  }
  .field input:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .field textarea { resize: vertical; }
  .contact-form .button { justify-content: center; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .form-status:empty { display: none; }
  .form-note { font-size: 0.8125rem; }
  .optional { font-weight: 400; color: var(--fg-muted); }
  .contact-title { font-size: var(--step-h2); line-height: 1.07; }
  @media (min-width: 48rem) {
    .contact { grid-template-columns: 1fr 1.1fr; gap: var(--space-8); }
    .contact-form { padding: var(--space-6); }
    .contact-form .button { justify-self: start; }
  }
</style>
