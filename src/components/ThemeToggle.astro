---
// Light/dark switch in the menu. Light is the default; the choice is remembered on this device.
// The saved choice is applied in the <head> of Base.astro, before the page is drawn, so it never flashes.
import { themeUI } from '../i18n/theme';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const label = themeUI[Astro.props.lang].dark;
---
<button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle title={label}>
  <svg class="icon-moon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1z" fill="currentColor" /></svg>
  <svg class="icon-sun" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="currentColor" /><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" /></g></svg>
  <span class="visually-hidden">{label}</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const root = document.documentElement;
    const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    btn.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#000000' : '#ffffff');
      sync();
    });
  }
</script>

<style>
  .theme-toggle {
    display: none; align-items: center; justify-content: center; width: 2rem; height: 2rem; padding: 0;
    border: 0; border-radius: 50%; background: none; color: var(--fg); opacity: 0.8; cursor: pointer;
  }
  :global(.js) .theme-toggle { display: inline-flex; }
  .theme-toggle:hover { opacity: 1; background: var(--bg-alt); }
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: block; }
  :global([data-theme='dark']) .icon-moon { display: none; }
</style>
