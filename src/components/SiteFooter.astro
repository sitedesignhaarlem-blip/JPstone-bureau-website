---
import WhatsAppIcon from './WhatsAppIcon.astro';
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
import { hasPage, pagePath, useTranslations, type Locale, type PageId } from '../i18n';
import { insightLocales, insightsBase } from '../insights';
import { insightsUI } from '../insights/ui';
import { accountUI, portalLangFor } from '../i18n/account';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const waHref = `${site.whatsapp}?text=${encodeURIComponent(t.contact.waHello)}`;
const services = (['yacht', 'hotel', 'rental', 'aiVideo', 'versus', 'pricing', 'faq'] as PageId[]).filter((p) => hasPage(lang, p));
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="footer-name"><LogoMark size={20} />{site.name}</p>
      <p class="muted">{t.footer.location}</p>
      {site.address && <p class="muted">{site.address}</p>}
    </div>
    <ul class="footer-list" role="list">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></li>
      <li><a class="footer-wa" href={waHref} rel="noopener"><WhatsAppIcon size={16} />WhatsApp</a></li>
      <li><a href={`/order/?lang=${portalLangFor(lang)}`} rel="nofollow">{accountUI[lang].order}</a></li>
      <li><a href={`/account/login/?lang=${portalLangFor(lang)}`} rel="nofollow">{accountUI[lang].nav}</a></li>
    </ul>
    {services.length > 0 && (
      <nav class="footer-links" aria-label={t.landing.services}>
        <ul role="list">
          {services.map((p) => <li><a href={pagePath(lang, p)}>{t.pages[p as keyof typeof t.pages]}</a></li>)}
          {insightLocales().includes(lang) && <li><a href={insightsBase(lang)}>{insightsUI[lang].name}</a></li>}
        </ul>
      </nav>
    )}
    <nav class="footer-links" aria-label={t.footer.legalNav}>
      <ul role="list">
        <li><a href={pagePath(lang, 'privacy')}>{t.footer.privacy}</a></li>
        <li><a href={pagePath(lang, 'terms')}>{t.footer.terms}</a></li>
        <li><a href={pagePath(lang, 'terms', '#cancellation')}>{t.footer.refund}</a></li>
        <li><a href={pagePath(lang, 'cookies')}>{t.footer.cookies}</a></li>
      </ul>
    </nav>
    <p class="footer-legal muted">
      © {year} {site.name}{site.kvk && ` · KvK ${site.kvk}`}{site.vat && ` · ${t.footer.vat} ${site.vat}`}<br />
      {t.footer.ai} {t.footer.font} <a href="/fonts/OFL.txt">SIL Open Font License</a>.
    </p>
  </div>
  {site.whatsappButton && (
    <a class="wa-float" href={waHref} rel="noopener" aria-label={t.contact.waFloat} title={t.contact.waFloat}><WhatsAppIcon size={28} /></a>
  )}
</footer>

<style>
  .footer-wa { display: inline-flex; align-items: center; gap: 0.4rem; }
  .footer-wa :global(.wa-icon) { color: #25d366; }
  /* Small round WhatsApp button, bottom right on every public page. Off: whatsappButton in src/data/site.ts. */
  .wa-float {
    position: fixed; z-index: 40; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%;
    background: #25d366; color: #fff; box-shadow: 0 4px 14px rgb(0 0 0 / 0.22); transition: transform var(--dur) var(--ease);
  }
  .wa-float:hover { transform: scale(1.06); text-decoration: none; }
  .wa-float:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } .wa-float:hover { transform: none; } }
  @media print { .wa-float { display: none; } }
  /* Room at the bottom so the round WhatsApp button never covers the last line. */
  .footer { background: var(--bg-alt); border-top: 1px solid var(--line); font-size: var(--step-small); padding-bottom: 4.5rem; }
  .footer-inner { display: grid; gap: var(--space-5); padding-block: var(--space-7); }
  .footer-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; }
  .footer-list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: 0; margin: 0; list-style: none; }
  .footer-legal { font-size: 0.75rem; max-width: none; line-height: 1.6; }
  .footer-links ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: 0; margin: 0; list-style: none; }
  .footer-links a { color: var(--fg); }
  @media (min-width: 48rem) {
    .footer-inner { grid-template-columns: 1fr auto; align-items: start; }
    .footer-links { grid-column: 1 / -1; }
    .footer-legal { grid-column: 1 / -1; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  }
</style>
