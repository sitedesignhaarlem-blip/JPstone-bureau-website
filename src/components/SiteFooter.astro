---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{site.name}</p>
      <p class="muted">{site.location}</p>
      <p class="muted"><span class="todo">{site.address}</span></p>
    </div>
    <ul class="footer-list" role="list">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></li>
      <li><a href={site.whatsapp} rel="noopener">WhatsApp</a></li>
    </ul>
    <nav class="footer-links" aria-label="Juridisch">
      <ul role="list">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/voorwaarden/">Voorwaarden</a></li>
        <li><a href="/voorwaarden/#annulering">Annulering en terugbetaling</a></li>
        <li><a href="/cookies/">Cookies</a></li>
      </ul>
    </nav>
    <p class="footer-legal muted">
      © {year} {site.name} · KvK <span class="todo">{site.kvk}</span> · btw <span class="todo">{site.vat}</span><br />
      Video's gemaakt met AI op basis van echte listingfoto's. Lettertype Hanken Grotesk, <a href="/fonts/OFL.txt">SIL Open Font License</a>.
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--bg-alt); border-top: 1px solid var(--line); font-size: var(--step-small); }
  .footer-inner { display: grid; gap: var(--space-5); padding-block: var(--space-7); }
  .footer-name { font-weight: 600; }
  .footer-list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: 0; margin: 0; list-style: none; }
  .footer-legal { font-size: 0.75rem; max-width: none; line-height: 1.6; }
  .footer-links ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: 0; margin: 0; list-style: none; }
  .footer-links a { color: var(--fg); }
  @media (min-width: 48rem) {
    .footer-inner { grid-template-columns: 1fr auto; align-items: start; }
    .footer-links { grid-column: 1 / -1; }
    .footer-legal { grid-column: 1 / -1; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  }
</style>
