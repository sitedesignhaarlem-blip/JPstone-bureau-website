---
// One looping shot. Plays muted while in view (see scripts/library.ts); click opens it larger.
import type { Shot } from '../data/library';
import { categoryLabel } from '../data/library';

interface Props {
  shot: Shot;
  size?: 'large' | 'normal';
}
const { shot, size = 'normal' } = Astro.props;
const src = `/media/${shot.file}`;
---
<figure class:list={['tile', `tile--${size}`]} data-category={shot.category}>
  <button class="tile-media" type="button" data-open={shot.file} aria-label={`Bekijk groter: ${shot.title}`}>
    <video muted playsinline loop preload="metadata" poster={`${src}.jpg`} aria-label={shot.alt}>
      <source src={`${src}.webm`} type="video/webm" />
      <source src={`${src}.mp4`} type="video/mp4" />
    </video>
  </button>
  <figcaption>
    <span class="tile-cat">{categoryLabel[shot.category]}</span>
    <span class="tile-title">{shot.title}</span>
  </figcaption>
</figure>

<style>
  .tile { display: grid; align-content: start; gap: var(--space-2); margin: 0; min-width: 0; }
  .tile[hidden] { display: none; }
  .tile-media {
    display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in;
    border-radius: var(--radius); overflow: hidden; background: var(--bg-alt);
    aspect-ratio: 4 / 3;
  }
  .tile--large .tile-media { aspect-ratio: 16 / 10; }
  .tile-media video { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease); }
  .tile-media:hover video { transform: scale(1.02); }
  figcaption { display: grid; gap: 2px; padding-inline: 2px; }
  .tile-cat { font-size: 0.75rem; font-weight: 600; color: var(--fg-muted); }
  .tile-title { font-size: 0.9375rem; line-height: 1.3; font-weight: 600; letter-spacing: var(--track-tight); }
  @media (min-width: 40rem) { .tile-title { font-size: var(--step-body); } }
  :global(.section--dark) .tile-media { background: #1d1d1f; }
  :global(.section--dark) .tile-cat { color: var(--on-dark-muted); }
</style>
