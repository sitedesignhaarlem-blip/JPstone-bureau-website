---
// English articles. Other languages: src/pages/[lang]/insights/[slug].astro.
import Article from '../../views/Article.astro';
import { articlesFor } from '../../insights';

export function getStaticPaths() {
  return articlesFor('en').map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
---
<Article article={Astro.props.article} />
