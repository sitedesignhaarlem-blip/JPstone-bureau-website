---
// Builds every page in every language from the templates in src/views and src/legal.
// Addresses come from src/i18n/config.ts (English at /, the others under /nl/, /de/, /fr/, /es/, /hr/).
import type { GetStaticPaths } from 'astro';
import { hasPage, locales, pageIds, slugs, defaultLocale, useTranslations, type Locale, type PageId } from '../i18n';
import Home from '../views/Home.astro';
import Library from '../views/Library.astro';
import How from '../views/How.astro';
import Contact from '../views/Contact.astro';
import Legal from '../layouts/Legal.astro';
import * as nl from '../legal/nl';
import * as en from '../legal/en';
import * as de from '../legal/de';
import * as fr from '../legal/fr';
import * as es from '../legal/es';
import * as hr from '../legal/hr';
import YachtEn from '../landing/en/YachtCharterVideo.astro';
import HotelEn from '../landing/en/HotelVideo.astro';
import AiVideoEn from '../landing/en/AiVideoFromPhotos.astro';
import PricingEn from '../landing/en/Pricing.astro';
import FaqEn from '../landing/en/Faq.astro';
import YachtNl from '../landing/nl/YachtCharterVideo.astro';
import HotelNl from '../landing/nl/HotelVideo.astro';
import AiVideoNl from '../landing/nl/AiVideoFromPhotos.astro';
import PricingNl from '../landing/nl/Pricing.astro';
import FaqNl from '../landing/nl/Faq.astro';
import YachtDe from '../landing/de/YachtCharterVideo.astro';
import HotelDe from '../landing/de/HotelVideo.astro';
import AiVideoDe from '../landing/de/AiVideoFromPhotos.astro';
import PricingDe from '../landing/de/Pricing.astro';
import FaqDe from '../landing/de/Faq.astro';
import YachtFr from '../landing/fr/YachtCharterVideo.astro';
import HotelFr from '../landing/fr/HotelVideo.astro';
import AiVideoFr from '../landing/fr/AiVideoFromPhotos.astro';
import PricingFr from '../landing/fr/Pricing.astro';
import FaqFr from '../landing/fr/Faq.astro';
import YachtEs from '../landing/es/YachtCharterVideo.astro';
import HotelEs from '../landing/es/HotelVideo.astro';
import AiVideoEs from '../landing/es/AiVideoFromPhotos.astro';
import PricingEs from '../landing/es/Pricing.astro';
import FaqEs from '../landing/es/Faq.astro';
import YachtHr from '../landing/hr/YachtCharterVideo.astro';
import HotelHr from '../landing/hr/HotelVideo.astro';
import AiVideoHr from '../landing/hr/AiVideoFromPhotos.astro';
import PricingHr from '../landing/hr/Pricing.astro';
import FaqHr from '../landing/hr/Faq.astro';

// Landing pages per language. A page only exists in the languages listed here
// (and in pageLocales in src/i18n/config.ts).
const landing: Partial<Record<Locale, Partial<Record<PageId, any>>>> = {
  en: { yacht: YachtEn, hotel: HotelEn, aiVideo: AiVideoEn, pricing: PricingEn, faq: FaqEn },
  nl: { yacht: YachtNl, hotel: HotelNl, aiVideo: AiVideoNl, pricing: PricingNl, faq: FaqNl },
  de: { yacht: YachtDe, hotel: HotelDe, aiVideo: AiVideoDe, pricing: PricingDe, faq: FaqDe },
  fr: { yacht: YachtFr, hotel: HotelFr, aiVideo: AiVideoFr, pricing: PricingFr, faq: FaqFr },
  es: { yacht: YachtEs, hotel: HotelEs, aiVideo: AiVideoEs, pricing: PricingEs, faq: FaqEs },
  hr: { yacht: YachtHr, hotel: HotelHr, aiVideo: AiVideoHr, pricing: PricingHr, faq: FaqHr },
};

export const getStaticPaths = (() =>
  locales.flatMap((lang) =>
    pageIds.filter((page) => hasPage(lang, page)).map((page) => {
      const parts = [lang === defaultLocale ? '' : lang, slugs[lang][page]].filter(Boolean);
      return { params: { path: parts.length ? parts.join('/') : undefined }, props: { lang, page } };
    }),
  )) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
  page: PageId;
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const legalTexts = { nl, en, de, fr, es, hr }[lang];
const legal = {
  privacy: { Body: legalTexts.Privacy, title: t.legal.privacyTitle, description: t.legal.privacyDesc },
  terms: { Body: legalTexts.Terms, title: t.legal.termsTitle, description: t.legal.termsDesc },
  cookies: { Body: legalTexts.Cookies, title: t.legal.cookiesTitle, description: t.legal.cookiesDesc },
}[page as 'privacy' | 'terms' | 'cookies'];
const LandingPage = landing[lang]?.[page];
---
{page === 'home' && <Home lang={lang} />}
{page === 'library' && <Library lang={lang} />}
{page === 'how' && <How lang={lang} />}
{page === 'contact' && <Contact lang={lang} />}
{LandingPage && <LandingPage />}
{legal && (
  <Legal lang={lang} page={page} title={legal.title} description={legal.description}>
    <legal.Body />
  </Legal>
)}
