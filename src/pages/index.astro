---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoTile from '../components/VideoTile.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

const formAction = site.formEndpoint || `mailto:${site.email}?subject=Proefvideo%20aanvraag`;
import { southernCross } from '../data/library';

const preview = ['southern-cross-drone-anker', 'southern-cross-kombuis', 'southern-cross-hut'].map(
  (f) => southernCross.find((s) => s.file === f)!,
);
---
<Base
  title="JPstone Bureau · Walkthrough-video's van je listingfoto's"
  description="Wij maken van de foto's op je listing een rustige walkthrough-video. Voor jachtcharters en boutique hotels. Geen draaidag, geen crew aan boord."
>
  <SiteNav />

  <main>
    <section class="hero" data-hero-section>
      <div class="hero-media" data-hero-fade="0.8">
        <video autoplay muted playsinline loop preload="auto" poster="/media/southern-cross-varen-zij.jpg" aria-label="Motorcatamaran Southern Cross vaart over open zee, gemaakt van listingfoto's." data-hero>
          <source src="/media/southern-cross-varen-zij.webm" type="video/webm" />
          <source src="/media/southern-cross-varen-zij.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="wrap hero-inner" data-hero-fade="0.4">
        <p class="eyebrow">Voor jachtcharters en boutique hotels</p>
        <h1 class="hero-title">Je listingfoto's worden een film. Zonder draaidag.</h1>
        <p class="lead">Je stuurt de foto's die al op je listing staan. Wij maken er een rustige rondleiding op video van.</p>
        <div class="actions">
          <a class="button" href="#contact">Vraag een gratis proefvideo aan</a>
          <a class="link-more" href="/bibliotheek/">Bekijk de bibliotheek</a>
        </div>
      </div>
    </section>

    <section class="section section--alt">
      <div class="wrap-wide">
        <div class="section-head">
          <h2>Uit de bibliotheek.</h2>
          <a class="link-more" href="/bibliotheek/">Alle clips van Southern Cross</a>
        </div>
        <div class="preview-grid">
          {preview.map((s) => <VideoTile shot={s} />)}
        </div>
      </div>
    </section>

    <section class="section" id="werkwijze">
      <div class="wrap">
        <h2 class="steps-title">Zo werkt het.</h2>
        <ol class="steps" role="list">
          <li><span class="numeral">1</span><h3>Je stuurt foto's</h3><p class="muted">Een link naar je listing is genoeg.</p></li>
          <li><span class="numeral">2</span><h3>Wij maken de film</h3><p class="muted">16:9 voor je site, 9:16 voor social.</p></li>
          <li><span class="numeral">3</span><h3>Jij publiceert</h3><p class="muted">Je krijgt mp4-bestanden, klaar om te plaatsen.</p></li>
        </ol>
      </div>
    </section>

    <section class="section section--alt" id="contact">
      <div class="wrap contact">
        <div class="contact-intro">
          <h2>Benieuwd hoe jouw listing eruitziet?</h2>
          <p class="lead muted">Stuur een link naar je listing. Dan maken we een gratis proefvideo.</p>
          <ul class="contact-direct" role="list">
            <li><span class="muted">WhatsApp</span><a href={site.whatsapp} rel="noopener">{site.phoneDisplay}</a></li>
            <li><span class="muted">Bellen</span><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></li>
            <li><span class="muted">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>

        <form class="contact-form" action={formAction} method="post" enctype={site.formEndpoint ? undefined : 'text/plain'} data-contact data-endpoint={site.formEndpoint} data-email={site.email}>
          <div class="field">
            <label for="cf-name">Naam</label>
            <input id="cf-name" name="naam" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="cf-company">Bedrijf</label>
            <input id="cf-company" name="bedrijf" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="cf-url">Website of listing</label>
            <input id="cf-url" name="listing" type="url" inputmode="url" placeholder="https://" required />
          </div>
          <div class="field">
            <label for="cf-msg">Bericht</label>
            <textarea id="cf-msg" name="bericht" rows="4"></textarea>
          </div>
          <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="button" type="submit">Vraag een gratis proefvideo aan</button>
          <p class="form-status muted" data-status aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter />

  <dialog id="shot-dialog" aria-label="Clip bekijken">
    <div class="dialog-inner">
      <video muted playsinline loop controls></video>
      <div class="dialog-bar">
        <p data-caption></p>
        <form method="dialog"><button class="close" type="submit">Sluiten</button></form>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import '../scripts/library.ts';

  // Contact form: post to the form service when one is set, otherwise open the mail app.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      const body = [...data.entries()].filter(([k]) => k !== '_gotcha').map(([k, v]) => `${k}: ${v}`).join('\n');
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Proefvideo aanvraag')}&body=${encodeURIComponent(body)}`;
      return;
    }
    if (status) status.textContent = 'Versturen…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      if (status) status.textContent = 'Verstuurd. Je hoort binnen een werkdag van ons.';
    } catch {
      if (status) status.textContent = `Dat lukte niet. Mail ons op ${form.dataset.email} of stuur een WhatsApp.`;
    }
  });

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLVideoElement>('[data-hero]');
  const section = document.querySelector<HTMLElement>('[data-hero-section]');
  const fading = document.querySelectorAll<HTMLElement>('[data-hero-fade]');

  // The hero loop stops for people who prefer less motion; the poster stays.
  if (hero && reduce) {
    hero.removeAttribute('autoplay');
    hero.pause();
  }

  // Fade the hero out as it scrolls away. Skipped when motion is reduced.
  if (section && !reduce) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const h = section.offsetHeight;
      const progress = Math.min(Math.max(window.scrollY / (h * 0.8), 0), 1);
      // Each layer fades over its own share of the hero height: the text first, then the video.
      fading.forEach((el) => {
        const share = Number(el.dataset.heroFade) || 0.8;
        el.style.opacity = String(1 - Math.min(window.scrollY / (h * share), 1));
      });
      if (hero) {
        if (progress >= 1) hero.pause();
        else if (hero.paused) hero.play().catch(() => {});
      }
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<style>
  .hero {
    position: relative; display: grid; align-items: end;
    min-height: calc(100svh - 3rem); overflow: hidden;
    background: var(--bg); color: var(--on-dark);
  }
  .hero-media { position: absolute; inset: 0; background: var(--dark); }
  .hero-media video { width: 100%; height: 100%; object-fit: cover; }
  /* Darken the lower part so the white text stays readable on any frame */
  .hero-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0.2) 45%, rgb(0 0 0 / 0) 70%),
      linear-gradient(to top, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0.55) 40%, rgb(0 0 0 / 0.15) 70%, rgb(0 0 0 / 0) 85%);
  }
  .hero-inner {
    position: relative; display: grid; justify-items: start; gap: var(--space-4);
    padding-block: var(--space-9) var(--space-8);
  }
  .hero .eyebrow { color: var(--on-dark); }
  .hero-title { max-width: 14ch; }
  .hero .lead { max-width: 34ch; color: var(--on-dark); }
  .hero .link-more { color: var(--accent-on-dark); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-3); }

  .wrap-wide { max-width: calc(var(--max-wide) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3) var(--space-6); margin-bottom: var(--space-7); }
  .preview-grid { display: grid; gap: var(--space-6); }

  .steps-title { margin-bottom: var(--space-7); }
  .steps { display: grid; gap: var(--space-6); padding: 0; list-style: none; }
  .steps li { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .steps .numeral { margin-bottom: var(--space-3); }

  .contact { display: grid; gap: var(--space-8); }
  .contact-intro { display: grid; gap: var(--space-4); align-content: start; }
  .contact-direct { display: grid; gap: var(--space-3); padding: 0; margin: var(--space-4) 0 0; list-style: none; }
  .contact-direct li { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .contact-form { display: grid; gap: var(--space-5); padding: var(--space-5); background: var(--bg); border-radius: var(--radius); }
  .field { display: grid; gap: var(--space-2); }
  .field label { font-size: var(--step-small); font-weight: 600; }
  .field input, .field textarea {
    width: 100%; padding: 0.75rem 0.875rem; font-size: var(--step-body);
    border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--fg);
  }
  .field input:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .field textarea { resize: vertical; }
  .contact-form .button { justify-content: center; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .form-status:empty { display: none; }

  dialog { width: min(100% - 2rem, 72rem); max-height: calc(100svh - 2rem); padding: 0; border: 0; border-radius: var(--radius); background: #000; color: var(--on-dark); overflow: hidden; }
  dialog::backdrop { background: rgb(0 0 0 / 0.8); }
  .dialog-inner video { width: 100%; max-height: calc(100svh - 7rem); object-fit: contain; background: #000; }
  .dialog-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-4); }
  .dialog-bar p { font-weight: 600; }
  .close { min-height: 2.75rem; padding: 0 var(--space-5); border-radius: var(--radius-pill); border: 0; background: #333336; color: var(--on-dark); cursor: pointer; }

  @media (min-width: 48rem) {
    .preview-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
    .steps { grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
    .contact { grid-template-columns: 1fr 1.1fr; gap: var(--space-8); }
    .contact-form { padding: var(--space-6); }
    .contact-form .button { justify-self: start; }
  }
</style>
