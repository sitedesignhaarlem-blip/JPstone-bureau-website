---
// Internal review page for tokens and typography. Not linked, not indexed, excluded from the sitemap.
import Base from '../layouts/Base.astro';

const colors = [
  ['--bg', '#F4F2EE', 'Bureaublad'],
  ['--surface', '#FFFFFF', 'Venster'],
  ['--fg', '#111111', 'Tekst · 18.9:1'],
  ['--fg-muted', '#555555', 'Secundair · 7.5:1'],
  ['--accent', '#8A6A2F', 'Alleen TODO en hover · 5.4:1'],
];
---
<Base title="Specimen · JPstone Bureau" description="Typography and token specimen" noindex>
  <header class="menu">
    <ul role="menu-bar" class="wrap">
      <li role="menu-item" tabindex="0" aria-haspopup="false"><a href="#">JPstone Bureau</a></li>
      <li role="menu-item" tabindex="0" aria-haspopup="false"><a href="#werk">Werk</a></li>
      <li role="menu-item" tabindex="0" aria-haspopup="false"><a href="#werkwijze">Werkwijze</a></li>
      <li role="menu-item" tabindex="0" aria-haspopup="false"><a href="#contact">Contact</a></li>
    </ul>
  </header>

  <main class="wrap page">
    <section class="window" aria-labelledby="hero-title">
      <div class="title-bar">
        <button aria-label="Sluiten" class="close" tabindex="-1"></button>
        <h1 class="title">JPstone Bureau</h1>
        <button aria-label="Vergroten" class="resize" tabindex="-1"></button>
      </div>
      <div class="separator"></div>
      <div class="window-pane hero">
        <p class="label">Voor jachtcharters en boutique hotels</p>
        <p class="display" id="hero-title">Je listingfoto's worden een film. Zonder draaidag.</p>
        <p class="lead">Je stuurt de foto's die al op je listing staan. Wij maken er een rustige rondleiding op video van. Geen crew aan boord, geen reisdag.</p>
        <p><a class="btn-default" href="#contact">Vraag een gratis proefvideo aan</a></p>
      </div>
    </section>

    <section class="window" id="werkwijze" aria-labelledby="steps-title">
      <div class="title-bar">
        <button aria-label="Sluiten" class="close" tabindex="-1"></button>
        <h2 class="title" id="steps-title">Zo werkt het</h2>
        <button aria-label="Vergroten" class="resize" tabindex="-1"></button>
      </div>
      <div class="separator"></div>
      <ol class="window-pane steps" role="list">
        <li><span class="numeral">1</span><div><h3>Je stuurt foto's</h3><p class="muted">Een link naar je listing is genoeg.</p></div></li>
        <li><span class="numeral">2</span><div><h3>Wij maken de film</h3><p class="muted">16:9 voor je site, 9:16 voor social.</p></div></li>
        <li><span class="numeral">3</span><div><h3>Jij publiceert</h3><p class="muted">Je krijgt mp4-bestanden, klaar om te plaatsen.</p></div></li>
      </ol>
    </section>

    <div class="pair">
      <section class="window" aria-labelledby="color-title">
        <div class="title-bar">
          <button aria-label="Sluiten" class="close" tabindex="-1"></button>
          <h2 class="title" id="color-title">Kleur</h2>
          <button aria-label="Vergroten" class="resize" tabindex="-1"></button>
        </div>
        <div class="separator"></div>
        <div class="window-pane"><ul class="swatches" role="list">
          {colors.map(([name, hex, note]) => (
            <li>
              <span class="chip" style={`background: var(${name})`}></span>
              <span><strong>{name}</strong> {hex}<br /><span class="muted">{note}</span></span>
            </li>
          ))}
        </ul></div>
      </section>

      <section class="window" id="contact" aria-labelledby="type-title">
        <div class="title-bar">
          <button aria-label="Sluiten" class="close" tabindex="-1"></button>
          <h2 class="title" id="type-title">Type &amp; elementen</h2>
          <button aria-label="Vergroten" class="resize" tabindex="-1"></button>
        </div>
        <div class="separator"></div>
        <div class="window-pane stack">
          <h2>Achttien jachten. Eén map met foto's.</h2>
          <p class="muted">Koppen in Chicago (system.css). Lopende tekst in Hanken Grotesk, 17px, regelafstand 1,6.</p>
          <div class="field">
            <label for="spec-name">Naam</label>
            <input id="spec-name" type="text" placeholder="Je naam" />
          </div>
          <p><a class="btn" href="#">Stuur</a> <a href="#">Tekstlink</a></p>
          <p><span class="todo">[TODO: citaat na akkoord klant]</span></p>
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .menu { background: var(--surface); border-bottom: 1.5px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .menu ul { display: flex; flex-wrap: wrap; }
  .menu a { text-decoration: none; }
  .menu li:first-child { font-weight: 700; }

  .page { display: grid; gap: var(--space-6); padding-block: var(--space-6) var(--space-8); }

  .hero.window-pane { display: grid; gap: var(--space-5); }
  .hero .display { max-width: 16ch; }
  .hero .btn-default { margin-top: var(--space-2); }

  .steps { list-style: none; display: grid; gap: 0; }
  .steps li { display: grid; grid-template-columns: 3.5rem 1fr; gap: var(--space-4); align-items: center; padding-block: var(--space-4); }
  .steps li + li { border-top: 1px dotted var(--line); }
  .steps h3 { margin-bottom: var(--space-1); }

  .pair { display: grid; gap: var(--space-6); }
  .swatches { list-style: none; display: grid; gap: var(--space-3); font-size: var(--step-small); }
  .swatches li { display: flex; gap: var(--space-3); align-items: center; }
  .chip { flex: none; width: 2.25rem; height: 2.25rem; border: 1.5px solid var(--line); }

  .field { display: grid; gap: var(--space-1); font-family: var(--font-ui); }
  .field input { padding: 0.4rem 0.5rem; width: 100%; max-width: 20rem; }

  @media (min-width: 48rem) {
    .steps li { grid-template-columns: 6rem 1fr; }
    .pair { grid-template-columns: 1fr 1.4fr; align-items: start; }
  }
</style>
