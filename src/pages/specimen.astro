---
// Internal review page for tokens and typography. Not linked, not indexed, excluded from the sitemap.
import Base from '../layouts/Base.astro';

const colors = [
  ['--bg', '#FFFFFF', 'Pagina'],
  ['--bg-alt', '#F5F5F7', 'Afwisselende sectie'],
  ['--fg', '#1D1D1F', 'Tekst · 16.8:1'],
  ['--fg-muted', '#6E6E73', 'Secundair · 5.1:1'],
  ['--accent', '#0071E3', 'Links en knop · 4.7:1'],
  ['--dark', '#000000', 'Videosecties'],
];
const scale = [
  ['Hero', 'var(--step-hero)', '40 → 80px · 600'],
  ['Kop', 'var(--step-h2)', '32 → 56px · 600'],
  ['Tussenkop', 'var(--step-h3)', '21 → 28px · 600'],
  ['Intro', 'var(--step-lead)', '19 → 24px · 400'],
  ['Tekst', 'var(--step-body)', '17px · 400'],
];
---
<Base title="Specimen · JPstone Bureau" description="Typography and token specimen" noindex>
  <header class="nav">
    <nav class="wrap nav-inner" aria-label="Hoofdmenu">
      <a class="nav-brand" href="#">JPstone Bureau</a>
      <ul role="list">
        <li><a href="#werk">Werk</a></li>
        <li><a href="#werkwijze">Werkwijze</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero section">
      <div class="wrap hero-inner">
        <p class="eyebrow">Voor jachtcharters en boutique hotels</p>
        <h1 class="hero-title">Je listingfoto's worden een film. Zonder draaidag.</h1>
        <p class="lead muted">Je stuurt de foto's die al op je listing staan. Wij maken er een rustige rondleiding op video van.</p>
        <div class="actions">
          <a class="button" href="#contact">Vraag een gratis proefvideo aan</a>
          <a class="link-more" href="#werk">Bekijk het werk</a>
        </div>
      </div>
      <div class="wrap-wide">
        <div class="media-frame" role="img" aria-label="Plek voor de showreel">
          <span>Showreel · wacht op bestand in /assets</span>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="werk">
      <div class="wrap stat">
        <p class="eyebrow">Virgin Charter Yachts</p>
        <p class="stat-figure">18</p>
        <h2>Achttien jachten. Eén map met foto's.</h2>
        <p class="lead muted">Levertijd: <span class="todo">[TODO: aantal dagen]</span></p>
      </div>
    </section>

    <section class="section section--alt" id="werkwijze">
      <div class="wrap">
        <h2 class="section-title">Zo werkt het.</h2>
        <ol class="steps" role="list">
          <li><span class="numeral">1</span><h3>Je stuurt foto's</h3><p class="muted">Een link naar je listing is genoeg.</p></li>
          <li><span class="numeral">2</span><h3>Wij maken de film</h3><p class="muted">16:9 voor je site, 9:16 voor social.</p></li>
          <li><span class="numeral">3</span><h3>Jij publiceert</h3><p class="muted">Je krijgt mp4-bestanden, klaar om te plaatsen.</p></li>
        </ol>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="wrap tokens">
        <div>
          <h2 class="h3">Kleur</h2>
          <ul class="swatches" role="list">
            {colors.map(([name, hex, note]) => (
              <li>
                <span class="chip" style={`background: var(${name})`}></span>
                <span><strong>{name}</strong> <span class="muted">{hex}</span><br /><span class="muted">{note}</span></span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="h3">Type</h2>
          <p class="muted small">SF Pro op Apple-apparaten, Hanken Grotesk op de rest.</p>
          <ul class="scale" role="list">
            {scale.map(([name, size, note]) => (
              <li><span class="sample" style={`font-size: ${size}`}>{name}</span><span class="muted small">{note}</span></li>
            ))}
          </ul>
          <p class="small"><span class="todo">[TODO: citaat na akkoord klant]</span></p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .nav { position: sticky; top: 0; z-index: 10; background: rgb(255 255 255 / 0.96); border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; font-size: 0.75rem; letter-spacing: -0.01em; }
  .nav ul { display: flex; gap: var(--space-5); padding: 0; list-style: none; }
  .nav a { color: var(--fg); opacity: 0.8; }
  .nav a:hover { opacity: 1; text-decoration: none; }
  .nav-brand { font-weight: 600; font-size: 0.875rem; opacity: 1 !important; }

  .hero { padding-bottom: var(--space-6); }
  .hero-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .hero-title { max-width: 14ch; }
  .hero .lead { max-width: 34ch; margin-top: var(--space-2); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-4); }

  .wrap-wide { max-width: calc(var(--max-wide) + 2 * var(--gutter)); margin: var(--space-8) auto 0; padding-inline: var(--gutter); }
  .media-frame { aspect-ratio: 16 / 9; border-radius: var(--radius); background: var(--dark); color: var(--on-dark-muted); display: grid; place-items: center; font-size: var(--step-small); }

  .stat { display: grid; justify-items: center; text-align: center; gap: var(--space-3); }
  .stat-figure { font-size: clamp(7rem, 4rem + 15vw, 14rem); font-weight: 600; line-height: 0.9; letter-spacing: -0.04em; }
  .stat h2 { max-width: 16ch; }
  .section--dark .todo { color: #fbbf24; }

  .section-title { margin-bottom: var(--space-7); }
  .steps { display: grid; gap: var(--space-6); padding: 0; list-style: none; }
  .steps li { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .steps .numeral { margin-bottom: var(--space-3); }

  .tokens { display: grid; gap: var(--space-8); }
  .h3 { font-size: var(--step-h3); margin-bottom: var(--space-5); }
  .small { font-size: var(--step-small); }
  .swatches, .scale { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .swatches li { display: flex; gap: var(--space-4); align-items: center; font-size: var(--step-small); }
  .chip { flex: none; width: 3rem; height: 3rem; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--line); }
  .scale { margin-block: var(--space-5); }
  .scale li { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); }
  .sample { font-weight: 600; letter-spacing: var(--track-tight); line-height: 1.1; }
  .scale li:nth-child(n + 4) .sample { font-weight: 400; }

  @media (min-width: 48rem) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
    .tokens { grid-template-columns: 1fr 1.3fr; }
  }
</style>
