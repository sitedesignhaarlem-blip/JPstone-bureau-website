---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Steps from '../components/Steps.astro';
---
<Base
  title="Werkwijze · JPstone Bureau"
  description="Zo werkt het: je stuurt je listingfoto's, wij maken er met AI een walkthrough-video van, jij publiceert."
>
  <SiteNav />
  <main id="inhoud">
    <Steps heading="h1" />
    <section class="section section--alt next">
      <div class="wrap next-inner">
        <h2>Zelf proberen?</h2>
        <p class="lead muted">Stuur een link naar je listing. Dan maken we een gratis proefvideo.</p>
        <a class="button" href="/contact/">Vraag een gratis proefvideo aan</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .next-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .next .button { margin-top: var(--space-3); }
</style>
