---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoTile from '../components/VideoTile.astro';
import { shots, southernMist, categories } from '../data/library';

const all = [...shots];
const counts = Object.fromEntries(
  categories.map((c) => [c.id, c.id === 'all' ? all.length : all.filter((s) => s.category === c.id).length]),
);
const [smLead, ...smRest] = southernMist;
---
<Base
  title="Bibliotheek · JPstone Bureau"
  description="Korte shots uit recente projecten: jachtcharters en boutique hotels, gemaakt van bestaande listingfoto's."
>
  <SiteNav />

  <main>
    <section class="section intro">
      <div class="wrap intro-inner">
        <p class="eyebrow">Bibliotheek</p>
        <h1 class="hero-title">Elk shot begon als een foto.</h1>
        <p class="lead muted">Korte clips uit recente projecten. Geen crew aan boord, geen drone in de lucht. Alleen de foto's die al op de listing stonden.</p>
      </div>
    </section>

    <section class="section section--dark project" aria-labelledby="sm-title">
      <div class="wrap-wide">
        <div class="project-head">
          <p class="eyebrow">Uitgelicht project</p>
          <h2 id="sm-title">Southern Mist</h2>
          <p class="lead muted">Motorcatamaran in de haven. Drie shots van romp, achterschip en dek, gemaakt van de listingfoto's.</p>
        </div>
        <div class="project-grid">
          <VideoTile shot={smLead} size="large" />
          <div class="project-rest">
            {smRest.map((s) => <VideoTile shot={s} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="all-title">
      <div class="wrap-wide">
        <div class="all-head">
          <h2 id="all-title">Alle shots.</h2>
          <div class="filters" role="group" aria-label="Filter op soort shot">
            {categories.map((c, i) => (
              <button type="button" class="chip" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {c.label} <span class="chip-count">{counts[c.id]}</span>
              </button>
            ))}
          </div>
          <p class="muted small" data-count aria-live="polite">{all.length} shots</p>
        </div>
        <div class="grid" id="library-grid">
          {all.map((s) => <VideoTile shot={s} />)}
        </div>
      </div>
    </section>

    <section class="section section--alt cta">
      <div class="wrap cta-inner">
        <h2>Benieuwd hoe jouw listing eruitziet?</h2>
        <p class="lead muted">Stuur een link naar je listing. Dan maken we een gratis proefvideo.</p>
        <a class="button" href="/#contact">Vraag een gratis proefvideo aan</a>
      </div>
    </section>
  </main>

  <dialog id="shot-dialog" aria-label="Shot bekijken">
    <div class="dialog-inner">
      <video muted playsinline loop controls></video>
      <div class="dialog-bar">
        <p data-caption></p>
        <form method="dialog"><button class="close" type="submit">Sluiten</button></form>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import '../scripts/library.ts';
</script>

<style>
  .intro { padding-bottom: var(--space-8); }
  .intro-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .intro .hero-title { max-width: 13ch; }
  .intro .lead { max-width: 36ch; }

  .wrap-wide { max-width: calc(var(--max-wide) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }

  .project-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); max-width: 40rem; }
  .project-grid { display: grid; gap: var(--space-6); }
  .project-rest { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }

  .all-head { display: grid; gap: var(--space-4); margin-bottom: var(--space-7); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    min-height: 2.75rem; padding: 0 var(--space-5); border-radius: var(--radius-pill);
    border: 1px solid var(--line); background: var(--bg); color: var(--fg);
    font-size: 0.9375rem; cursor: pointer; transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .chip:hover { border-color: var(--fg-muted); }
  .chip[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .chip-count { opacity: 0.6; margin-left: 2px; font-variant-numeric: tabular-nums; }
  .small { font-size: var(--step-small); }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-3); }

  .cta-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .cta .button { margin-top: var(--space-3); }

  dialog {
    width: min(100% - 2rem, 72rem); max-height: calc(100svh - 2rem); padding: 0; border: 0;
    border-radius: var(--radius); background: #000; color: var(--on-dark); overflow: hidden;
  }
  dialog::backdrop { background: rgb(0 0 0 / 0.8); }
  .dialog-inner video { width: 100%; max-height: calc(100svh - 7rem); object-fit: contain; background: #000; }
  .dialog-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-4); }
  .dialog-bar p { font-weight: 600; }
  .close { min-height: 2.75rem; padding: 0 var(--space-5); border-radius: var(--radius-pill); border: 0; background: #333336; color: var(--on-dark); cursor: pointer; }
  .close:hover { background: #48484a; }

  @media (min-width: 40rem) {
    .grid { gap: var(--space-7) var(--space-5); }
    .project-rest { gap: var(--space-5); }
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .all-head { grid-template-columns: 1fr auto; align-items: end; }
    .all-head [data-count] { grid-column: 1 / -1; }
  }
</style>
