---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoTile from '../components/VideoTile.astro';
import { southernCross } from '../data/library';

---
<Base
  title="Bibliotheek · JPstone Bureau"
  description="Southern Cross: zes clips van een motorcatamaran, gemaakt van de bestaande listingfoto's."
>
  <SiteNav />

  <main>
    <section class="section intro">
      <div class="wrap intro-inner">
        <p class="eyebrow">Bibliotheek</p>
        <h1 class="hero-title">Elk shot begon als een foto.</h1>
        <p class="lead muted">Korte clips uit recente projecten. Geen crew aan boord, geen drone in de lucht. Alleen de foto's die al op de listing stonden.</p>
      </div>
    </section>

    <section class="section section--dark project" aria-labelledby="sc-title">
      <div class="wrap-wide">
        <div class="project-head">
          <p class="eyebrow">Uitgelicht project</p>
          <h2 id="sc-title">Southern Cross</h2>
          <p class="lead muted">Motorcatamaran, buiten en binnen. Zes clips: op zee, voor anker, het achterdek en een rondgang door kombuis, salon en hut.</p>
        </div>
        <div class="project-grid">
          {southernCross.map((s) => <VideoTile shot={s} />)}
        </div>
      </div>
    </section>


    <section class="section section--alt cta">
      <div class="wrap cta-inner">
        <h2>Benieuwd hoe jouw listing eruitziet?</h2>
        <p class="lead muted">Stuur een link naar je listing. Dan maken we een gratis proefvideo.</p>
        <a class="button" href="/#contact">Vraag een gratis proefvideo aan</a>
      </div>
    </section>
  </main>

  <dialog id="shot-dialog" aria-label="Shot bekijken">
    <div class="dialog-inner">
      <video muted playsinline loop controls></video>
      <div class="dialog-bar">
        <p data-caption></p>
        <form method="dialog"><button class="close" type="submit">Sluiten</button></form>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import '../scripts/library.ts';
</script>

<style>
  .intro { padding-bottom: var(--space-8); }
  .intro-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .intro .hero-title { max-width: 13ch; }
  .intro .lead { max-width: 36ch; }

  .wrap-wide { max-width: calc(var(--max-wide) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }

  .project-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); max-width: 40rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-3); }



  .cta-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .cta .button { margin-top: var(--space-3); }

  dialog {
    width: min(100% - 2rem, 72rem); max-height: calc(100svh - 2rem); padding: 0; border: 0;
    border-radius: var(--radius); background: #000; color: var(--on-dark); overflow: hidden;
  }
  dialog::backdrop { background: rgb(0 0 0 / 0.8); }
  .dialog-inner video { width: 100%; max-height: calc(100svh - 7rem); object-fit: contain; background: #000; }
  .dialog-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-4); }
  .dialog-bar p { font-weight: 600; }
  .close { min-height: 2.75rem; padding: 0 var(--space-5); border-radius: var(--radius-pill); border: 0; background: #333336; color: var(--on-dark); cursor: pointer; }
  .close:hover { background: #48484a; }

  @media (min-width: 40rem) {
    .project-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-7) var(--space-5); }
  }
</style>
