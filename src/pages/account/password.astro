---
// Change the password. After a reset link (pw_reset cookie, valid 15 minutes) no current password is
// asked; otherwise it is checked first, with the same attempt limits as logging in. After a change,
// all other sessions are logged out.
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import { currentEmail, isAdmin, passwordIsCorrect, portalReady, userClient } from '../../lib/supabase';
import { isLimited, limits, recordAttempt } from '../../lib/ratelimit';
import { passwordProblem, PASSWORD_MAX } from '../../lib/password';
import { clientIp } from '../../lib/request';
import { portalLang, portalUI } from '../../i18n/portal';

const lang = portalLang(Astro.url, Astro.request, Astro.cookies.get('lang')?.value);
const p = portalUI[lang];
const w = p.pw;
const email = await currentEmail(Astro.request, Astro.cookies);
if (!portalReady || !email) return Astro.redirect('/account/login/?next=/account/password/');
const reset = Astro.cookies.get('pw_reset')?.value === '1';
let error = '';
let saved = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const next = String(form.get('password') ?? '');
  const keys = [limits.loginEmail(email), limits.loginIp(clientIp(Astro))];
  if (!reset && await isLimited(keys)) error = p.login.locked;
  else if (!reset && !(await passwordIsCorrect(email, String(form.get('current') ?? '')))) {
    await recordAttempt(keys);
    error = w.wrongCurrent;
  } else {
    const problem = await passwordProblem(next, String(form.get('repeat') ?? ''), email);
    if (problem) error = p.pwProblem[problem];
    else {
      const supabase = userClient(Astro.request, Astro.cookies);
      const { error: e } = await supabase.auth.updateUser({ password: next });
      if (e) error = e.code === 'same_password' ? p.pwProblem.same : p.login.error;
      else {
        await supabase.auth.signOut({ scope: 'others' });
        Astro.cookies.delete('pw_reset', { path: '/account/' });
        saved = true;
      }
    }
  }
}
---
<Portal lang={lang} title={w.title} path="/account/password/" email={email} admin={isAdmin(email)}>
  <h1>{w.title}</h1>
  {saved ? <p class="notice" role="status">{w.saved}</p> : (
    <>
      {error && <p class="notice notice--error" role="alert">{error}</p>}
      <form class="card" method="post">
        {reset && <p class="muted">{w.resetLead}</p>}
        <input type="text" name="username" autocomplete="username" value={email} hidden />
        {!reset && <div class="field"><label for="current">{w.current}</label><input id="current" name="current" type="password" autocomplete="current-password" required maxlength="200" /></div>}
        <div class="field">
          <label for="password">{w.next}</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required minlength="10" maxlength={PASSWORD_MAX} aria-describedby="pw-hint" />
          <p id="pw-hint" class="muted hint">{p.register.passwordHint}</p>
        </div>
        <div class="field"><label for="repeat">{w.repeat}</label><input id="repeat" name="repeat" type="password" autocomplete="new-password" required minlength="10" maxlength={PASSWORD_MAX} /></div>
        <div><button class="button" type="submit">{w.submit}</button></div>
      </form>
    </>
  )}
  <p><a href="/account/">← {p.back}</a></p>
</Portal>
