---
import InsightsIndex from '../../../views/InsightsIndex.astro';
import { defaultLocale, type Locale } from '../../../i18n';
import { insightLocales } from '../../../insights';

export function getStaticPaths() {
  return insightLocales().filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
---
<InsightsIndex lang={Astro.params.lang as Locale} />
