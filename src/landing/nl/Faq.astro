---
import Landing from '../../layouts/Landing.astro';
import { groups } from './faq';
import { faqAnchor } from '../../i18n/search';

const lang = 'nl';
const all = groups.flatMap((g) => g.items);
---
<Landing
  lang={lang}
  page="faq"
  title="Veelgestelde vragen over AI-walkthroughvideo's · Still to Film"
  description="Antwoorden over Still to Film: gebruiksrecht, levering, formaten, welke foto's je nodig hebt, AI en de controle door een mens, prijzen en betaling."
  eyebrow="FAQ"
  h1="Veelgestelde vragen"
  summary="Still to Film maakt walkthrough-video's van 60–90 seconden van de listingfoto's van jachtcharters en boutique hotels, in 16:9 en 9:16, voor €50 tot €100 per video. Hieronder staan de antwoorden op de vragen die we het vaakst krijgen, per onderwerp."
  faqItems={all}
  showFaq={false}
  service
  related={['pricing', 'yacht', 'hotel', 'aiVideo']}
>
  {groups.map((group) => (
    <>
      <h2>{group.title}</h2>
      {group.items.map((item) => (
        <details id={faqAnchor(item.q)}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </>
  ))}
</Landing>
