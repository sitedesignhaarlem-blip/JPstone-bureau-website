---
import Landing from '../../layouts/Landing.astro';
import { groups } from './faq';

const lang = 'en';
const all = groups.flatMap((g) => g.items);
---
<Landing
  lang={lang}
  page="faq"
  title="Frequently asked questions about AI walkthrough videos · Still to Film"
  description="Answers about Still to Film videos: usage rights, delivery, formats, which photos you need, how AI and the human check work, pricing and payment."
  eyebrow="FAQ"
  h1="Frequently asked questions"
  summary="Still to Film makes 60–90 second walkthrough videos from the listing photos of yacht charters and boutique hotels, in 16:9 and 9:16, from €50 to €100 per video. Below are the answers to the questions we get most, grouped by topic."
  faqItems={all}
  showFaq={false}
  service
  related={['pricing', 'yacht', 'hotel', 'aiVideo']}
>
  {groups.map((group) => (
    <>
      <h2>{group.title}</h2>
      {group.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </>
  ))}
</Landing>
