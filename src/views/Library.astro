---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoTile from '../components/VideoTile.astro';
import ShotDialog from '../components/ShotDialog.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { southernCross } from '../data/library';
import { pagePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<Base title={t.meta.libraryTitle} description={t.meta.libraryDesc} lang={lang} page="library" videos={southernCross.map((s) => s.file)}>
  <SiteNav lang={lang} page="library" />

  <main id="main">
    <section class="section intro">
      <div class="wrap intro-inner">
        <p class="eyebrow">{t.library.eyebrow}</p>
        <h1 class="hero-title">{t.library.title}</h1>
        <p class="lead muted">{t.library.lead}</p>
      </div>
    </section>

    <section class="section section--dark project" aria-labelledby="sc-title">
      <div class="wrap-wide">
        <div class="project-head">
          <p class="eyebrow">{t.library.featured}</p>
          <h2 id="sc-title">Southern Cross</h2>
          <p class="lead muted">{t.library.projectLead}</p>
        </div>
        <div class="project-grid">
          {southernCross.map((s) => <VideoTile shot={s} lang={lang} />)}
        </div>
      </div>
    </section>

    <CaseStudy lang={lang} />

    <section class="section section--alt cta">
      <div class="wrap cta-inner">
        <h2>{t.contact.title}</h2>
        <p class="lead muted">{t.contact.lead}</p>
        <a class="button" href={pagePath(lang, 'contact')}>{t.hero.cta}</a>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
  <ShotDialog lang={lang} />
</Base>

<style>
  .intro { padding-bottom: var(--space-8); }
  .intro-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .intro .hero-title { max-width: 13ch; }
  .intro .lead { max-width: 36ch; }

  .wrap-wide { max-width: calc(var(--max-wide) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }

  .project-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); max-width: 40rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-3); }

  .cta-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .cta .button { margin-top: var(--space-3); }

  @media (min-width: 40rem) {
    .project-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-7) var(--space-5); }
  }
</style>
