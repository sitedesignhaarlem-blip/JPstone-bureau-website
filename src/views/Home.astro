---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShotDialog from '../components/ShotDialog.astro';
import Steps from '../components/Steps.astro';
import ContactSection from '../components/ContactSection.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Packages from '../components/Packages.astro';
import Faq from '../components/Faq.astro';
import Vertical from '../components/Vertical.astro';
import DoneForYou from '../components/DoneForYou.astro';
import { hasPage, pagePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<Base title={t.meta.homeTitle} preloadImage="/media/hero.jpg" description={t.meta.homeDesc} lang={lang} page="home" service faqItems={t.faq.items} videos={['southern-cross-varen-zij', 'southern-cross-drone-anker', 'southern-cross-kombuis']}>
  <SiteNav lang={lang} page="home" />

  <main id="main">
    <section class="hero" data-hero-section>
      <div class="hero-media" data-hero-fade="0.8">
        <img class="hero-still" src="/media/hero.jpg" alt="" width="720" height="534" fetchpriority="high" decoding="async" />
        <video muted playsinline loop preload="none" aria-label={t.hero.videoAlt} data-hero>
          <source src="/media/southern-cross-varen-zij.mp4" type="video/mp4" media="(min-width: 50rem)" />
          <source src="/media/southern-cross-varen-zij.webm" type="video/webm" media="(min-width: 50rem)" />
          <source src="/media/hero.mp4" type="video/mp4" />
          <source src="/media/hero.webm" type="video/webm" />
        </video>
      </div>
      <div class="wrap hero-inner" data-hero-fade="0.4">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 class="hero-title">{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="button" href={pagePath(lang, 'contact')}>{t.hero.cta}</a>
          <a class="link-more" href={pagePath(lang, 'library')}>{t.hero.more}</a>
        </div>
      </div>
    </section>

    <BeforeAfter lang={lang} />

    <DoneForYou lang={lang} />

    <Vertical lang={lang} />

    <Steps lang={lang} />

    <Packages lang={lang} />

    <Faq lang={lang} more={hasPage(lang, 'faq') ? { href: pagePath(lang, 'faq'), label: t.landing.allQuestions } : undefined} />

    <ContactSection lang={lang} />
  </main>

  <SiteFooter lang={lang} />
  <ShotDialog lang={lang} />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLVideoElement>('[data-hero]');
  const section = document.querySelector<HTMLElement>('[data-hero-section]');
  const fading = document.querySelectorAll<HTMLElement>('[data-hero-fade]');

  // The hero loop starts once the page has loaded, so the still image shows first and fast.
  // People who prefer less motion keep the still image.
  let heroStarted = false;
  if (hero && !reduce) {
    const start = () => {
      heroStarted = true;
      // The still image stays underneath until the video actually plays, so there is never a gap.
      hero.addEventListener('playing', () => hero.classList.add('is-playing'), { once: true });
      hero.play().catch(() => {});
    };
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }

  // Fade the hero out as it scrolls away. Skipped when motion is reduced.
  if (section && !reduce) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const h = section.offsetHeight;
      const progress = Math.min(Math.max(window.scrollY / (h * 0.8), 0), 1);
      // Each layer fades over its own share of the hero height: the text first, then the video.
      fading.forEach((el) => {
        const share = Number(el.dataset.heroFade) || 0.8;
        el.style.opacity = String(1 - Math.min(window.scrollY / (h * share), 1));
      });
      if (hero) {
        if (progress >= 1) hero.pause();
        else if (heroStarted && hero.paused) hero.play().catch(() => {});
      }
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<style>
  .hero {
    position: relative; display: grid; align-items: end;
    min-height: calc(100svh - 3rem); overflow: hidden;
    background: var(--bg); color: var(--on-dark);
  }
  .hero-media { position: absolute; inset: 0; background: var(--dark); }
  .hero-still, .hero-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-media video { opacity: 0; transition: opacity 600ms var(--ease); }
  .hero-media video.is-playing { opacity: 1; }
  /* Darken the lower part so the white text stays readable on any frame */
  .hero-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0.2) 45%, rgb(0 0 0 / 0) 70%),
      linear-gradient(to top, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0.55) 40%, rgb(0 0 0 / 0.15) 70%, rgb(0 0 0 / 0) 85%);
  }
  .hero-inner {
    position: relative; display: grid; justify-items: start; gap: var(--space-4);
    padding-block: var(--space-9) var(--space-8);
  }
  .hero .eyebrow { color: var(--on-dark); }
  .hero-title { max-width: 14ch; }
  .hero .lead { max-width: 34ch; color: var(--on-dark); }
  .hero .link-more { color: var(--accent-on-dark); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-3); }
</style>
