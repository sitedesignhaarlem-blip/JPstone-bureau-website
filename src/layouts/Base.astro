---
import '../styles/tokens.css';
import '../styles/base.css';
import { SITE_URL, site } from '../data/site';
import { locales, defaultLocale, htmlLang, ogLocale, pagePath, useTranslations, type Locale, type PageId } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  page: PageId;
  noindex?: boolean;
  /** Clips shown on this page, added as VideoObject structured data. */
  videos?: string[];
  /** The first large image on the page; loaded with priority. */
  preloadImage?: string;
  /** Address of a page outside the normal page list (e.g. a prospect page). Turns off language alternates. */
  path?: string;
}
const { title, description, lang, page, noindex = false, videos = [], preloadImage, path } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(path ?? pagePath(lang, page), SITE_URL).href;
const abs = (path: string) => new URL(path, SITE_URL).href;

// Structured data: the business on every page, plus the clips on pages that show them.
const business = {
  '@type': 'ProfessionalService',
  '@id': abs('/#business'),
  name: site.name,
  url: abs(pagePath(lang, 'home')),
  email: site.email,
  telephone: site.phoneE164,
  image: abs('/og.jpg'),
  address: { '@type': 'PostalAddress', addressCountry: site.country },
  areaServed: 'Worldwide',
  description: t.meta.homeDesc,
};
const videoObjects = videos.map((file) => ({
  '@type': 'VideoObject',
  name: `${t.shots[file as keyof typeof t.shots].title} · Southern Cross`,
  description: t.shots[file as keyof typeof t.shots].alt,
  thumbnailUrl: abs(`/media/${file}.jpg`),
  contentUrl: abs(`/media/${file}.mp4`),
  uploadDate: '2026-09-03',
  inLanguage: htmlLang[lang],
  creator: { '@id': abs('/#business') },
}));
const jsonLd = { '@context': 'https://schema.org', '@graph': [business, ...videoObjects] };
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!path && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(pagePath(l, page), SITE_URL).href} />)}
    {!path && <link rel="alternate" hreflang="x-default" href={new URL(pagePath(defaultLocale, page), SITE_URL).href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={abs('/og.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // A new page always opens at the top, unless the link points to a section (#…).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      addEventListener('pageshow', () => { if (!location.hash) scrollTo(0, 0); });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
