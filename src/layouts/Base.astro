---
import Analytics from '@vercel/analytics/astro';
import '../styles/tokens.css';
import '../styles/base.css';
import { SITE_URL, site } from '../data/site';
import { breadcrumbs, faqPage, organization, service, videoObject, website, type FaqItem } from '../data/schema';
import { localesFor, defaultLocale, htmlLang, hreflang, ogLocale, pagePath, useTranslations, type Locale, type PageId } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  page: PageId;
  noindex?: boolean;
  /** Clips shown on this page, added as VideoObject structured data. */
  videos?: string[];
  /** Questions shown on the page: adds FAQPage structured data with the same texts. */
  faqItems?: FaqItem[];
  /** The page describes the service: adds Service structured data. */
  service?: boolean;
  /** The first large image on the page; loaded with priority. */
  preloadImage?: string;
  /** Address of a page outside the normal page list (e.g. a prospect page). Turns off language alternates. */
  path?: string;
}
const { title, description, lang, page, noindex = false, videos = [], faqItems = [], service: isService = false, preloadImage, path } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(path ?? pagePath(lang, page), SITE_URL).href;
const abs = (path: string) => new URL(path, SITE_URL).href;

// Structured data: organisation and website on every page, plus what this page shows.
const graph: object[] = [organization(), website()];
if (isService) graph.push(page === 'home' ? service(lang) : service(lang, { name: title, description, url: canonical }));
if (faqItems.length) graph.push(faqPage(lang, canonical, faqItems));
// Only languages this page exists in get an hreflang alternate.
const alternateLocales = localesFor(page);
graph.push(...videos.map((file) => videoObject(lang, file)));
if (page !== 'home' && !path) graph.push(breadcrumbs(lang, page));
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!path && alternateLocales.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={new URL(pagePath(l, page), SITE_URL).href} />)}
    {!path && <link rel="alternate" hreflang="x-default" href={new URL(pagePath(defaultLocale, page), SITE_URL).href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={abs('/og.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.hero.videoAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternateLocales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // A new page always opens at the top, unless the link points to a section (#…).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      addEventListener('pageshow', () => { if (!location.hash) scrollTo(0, 0); });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
    <Analytics />
  </body>
</html>
