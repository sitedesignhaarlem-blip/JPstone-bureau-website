      <tr><td data-label="Número de vídeos">De 5 a 9</td><td data-label="Precio por vídeo">95 €</td></tr>
      <tr><td data-label="Número de vídeos">De 10 a 14</td><td data-label="Precio por vídeo">90 €</td></tr>
      <tr><td data-label="Número de vídeos">Cada 5 vídeos más</td><td data-label="Precio por vídeo">5 € menos, hasta 50 €</td></tr>
