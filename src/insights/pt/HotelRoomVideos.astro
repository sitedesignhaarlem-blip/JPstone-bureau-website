      <tr><td data-label="Número de vídeos">De 10 a 14</td><td data-label="Preço por vídeo">90 €</td></tr>
      <tr><td data-label="Número de vídeos">Cada 5 vídeos a mais</td><td data-label="Preço por vídeo">Menos 5 €, até 50 €</td></tr>
